{
	"schemaVersion": 1,
	"id": "embervoid-gametest",
	"version": "${version}",
	"name": "Embervoid GameTests",
	"description": "In-game tests for Embervoid, run by ./gradlew runGametest. Dev only, never shipped.",
	"license": "All-Rights-Reserved",
	"environment": "*",
	"entrypoints": {
		"fabric-gametest": [
			"com.embervoid.gametest.MobLevelTests",
			"com.embervoid.gametest.MoonTests",
			"com.embervoid.gametest.PlayerTests",
			"com.embervoid.gametest.SanctumTests",
			"com.embervoid.gametest.NightMobTests",
			"com.embervoid.gametest.VampireTests",
			"com.embervoid.gametest.GearTests",
			"com.embervoid.gametest.ReliquaryTests",
			"com.embervoid.gametest.BossFrameworkTests",
			"com.embervoid.gametest.ArenaTemplateTests"
		]
	},
	"mixins": [
		"embervoid-gametest.mixins.json"
	],
	"depends": {
		"embervoid": "*",
		"fabric-gametest-api-v1": "*"
	}
}
